# =============================================================================
# OpenClaw Virtual Office — Proxy Dockerfile
# Node.js прокси-сервер: /api/* → backend, /socket.io/* → backend, static → frontend
# =============================================================================

FROM node:22-alpine

WORKDIR /app

# Копируем proxy-server.js
COPY proxy-server.js ./proxy-server.js

# Копируем собранную статику фронтенда
COPY apps/frontend/dist ./apps/frontend/dist

# Переменные среды по умолчанию (переопределяются через docker-compose)
ENV BACKEND_HOST=backend \
    BACKEND_PORT=3000 \
    STATIC_DIR=/app/apps/frontend/dist \
    PROXY_PORT=8080

EXPOSE 8080

CMD ["node", "proxy-server.js"]
