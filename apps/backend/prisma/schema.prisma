// This is your Prisma schema file for OpenClaw Virtual Office
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USERS (Auth BC)
// ==========================================
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  tenantId     String   @map("tenant_id")
  role         String   @default("USER") // USER, ADMIN
  version      Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@index([tenantId])
  @@index([email])
  @@map("users")
}

// ==========================================
// REFRESH TOKENS (Auth BC)
// ==========================================
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ==========================================
// AGENTS (Agent Lifecycle BC)
// ==========================================
model Agent {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  role         String   // WORKER, MANAGER, ARCHIVIST, FINANCIER, DIRECTOR
  departmentId String?  @map("department_id")
  status       String   @default("IDLE") // IDLE, BUSY, ERROR, AWAITING_INPUT
  version      Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  presence     Presence?
  messages     Message[]

  @@index([tenantId])
  @@index([departmentId])
  @@index([status])
  @@map("agents")
}

// ==========================================
// FLOORS (Office Layout BC)
// ==========================================
model Floor {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  name       String
  templateId String?  @map("template_id")
  version    Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  zones Zone[]

  @@index([tenantId])
  @@map("floors")
}

// ==========================================
// ZONES (Office Layout BC)
// ==========================================
model Zone {
  id       String  @id @default(uuid())
  floorId  String  @map("floor_id")
  tenantId String  @map("tenant_id")
  name     String
  type     String  // WORK, REST, SMOKING, FINANCE, DIRECTOR, ARCHIVE
  capacity Int     @default(10)
  version  Int     @default(0)

  floor         Floor          @relation(fields: [floorId], references: [id])
  officeObjects OfficeObject[]
  presence      Presence[]
  chatRooms     ChatRoom[]

  @@index([floorId])
  @@index([tenantId])
  @@map("zones")
}

// ==========================================
// OFFICE OBJECTS (Office Layout BC)
// ==========================================
model OfficeObject {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  zoneId    String   @map("zone_id")
  type      String   // DESK, SOFA, DOOR, ICON
  agentId   String?  @map("agent_id")
  x         Float    @default(0)
  y         Float    @default(0)
  metadata  Json?    // Additional metadata (dimensions, etc.)
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  zone Zone @relation(fields: [zoneId], references: [id])

  @@index([tenantId])
  @@index([zoneId])
  @@index([agentId])
  @@map("office_objects")
}

// ==========================================
// PRESENCE (Presence & Activity BC)
// ==========================================
model Presence {
  id          String   @id @default(uuid())
  agentId     String   @unique @map("agent_id")
  tenantId    String   @map("tenant_id")
  zoneId      String?  @map("zone_id")
  state       String   @default("IDLE") // WORKING, RESTING, SMOKING, CHATTING, IDLE
  version     Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id])
  zone  Zone? @relation(fields: [zoneId], references: [id])

  @@index([tenantId])
  @@index([zoneId])
  @@map("presence")
}

// ==========================================
// MESSAGES (Communication BC)
// ==========================================
model Message {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  roomId        String   @map("room_id")
  authorAgentId String   @map("author_agent_id")
  text          String
  createdAt     DateTime @default(now()) @map("created_at")

  room   ChatRoom @relation(fields: [roomId], references: [id])
  author Agent    @relation(fields: [authorAgentId], references: [id])

  @@index([tenantId])
  @@index([roomId])
  @@index([authorAgentId])
  @@map("messages")
}

// ==========================================
// CHAT ROOMS (Communication BC)
// ==========================================
model ChatRoom {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  zoneId       String?  @map("zone_id")
  participants Json     @default("[]") // Array of { agentId, joinedAt }
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  zone     Zone?     @relation(fields: [zoneId], references: [id])
  messages Message[]

  @@index([tenantId])
  @@index([zoneId])
  @@map("chat_rooms")
}

// ==========================================
// EVENTS (Audit & Replay BC)
// ==========================================
model Event {
  id            BigInt   @id @default(autoincrement())
  eventId       String   @unique @map("event_id") @default(uuid())
  eventType     String   @map("event_type")
  sourceBC      String   @map("source_bc")
  aggregateId   String   @map("aggregate_id")
  tenantId      String   @map("tenant_id")
  payload       Json
  correlationId String?  @map("correlation_id")
  causationId   String?  @map("causation_id")
  commandId     String?  @map("command_id")
  version       Int      @default(1)
  occurredAt    DateTime @default(now()) @map("occurred_at")

  @@index([tenantId])
  @@index([aggregateId])
  @@index([eventType])
  @@index([correlationId])
  @@index([commandId])
  @@index([occurredAt])
  @@map("events")
}

// ==========================================
// OUTBOX (Outbox Pattern - cross-cutting)
// ==========================================
model Outbox {
  id          String    @id @default(uuid())
  eventId     String    @unique @map("event_id")
  eventType   String    @map("event_type")
  aggregateId String    @map("aggregate_id")
  tenantId    String    @map("tenant_id")
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime? @map("processed_at")
  retries     Int       @default(0)
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([processed])
  @@index([tenantId])
  @@index([createdAt])
  @@map("outbox")
}

// ==========================================
// INBOX (Deduplication - cross-cutting)
// ==========================================
model Inbox {
  id          String   @id @default(uuid())
  eventId     String   @unique @map("event_id")
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([eventId])
  @@map("inbox")
}

// ==========================================
// TASKS (Task Management BC)
// ==========================================
enum TaskStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model Task {
  id              String     @id @default(uuid())
  tenantId        String
  title           String
  description     String?
  status          TaskStatus @default(PENDING)
  agentId         String?    // ID агента-исполнителя (из таблицы agents)
  agentName       String?    // имя агента для отображения
  sessionKey      String?    // OpenClaw session key для истории
  result          String?    // краткий итог
  historySnapshot Json?      @map("history_snapshot") // кеш истории сессии (защита от cleanup JSONL файлов)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("tasks")
}

// ==========================================
// AI COMPANY — PIPELINE BC
// ==========================================

enum ProjectType {
  WEB_APP
  TELEGRAM_BOT
  MICRO_SERVICE
  LANDING
  CUSTOM
}

enum PipelineStatus {
  PENDING
  RUNNING
  PAUSED
  BLOCKED
  COMPLETED
  FAILED
  CANCELLED
}

enum StageStatus {
  PENDING
  ACTIVE
  IN_REVIEW
  APPROVED
  REJECTED
  SKIPPED
  COMPLETED
  FAILED
}

enum ArtifactType {
  PRD
  ADR
  C4_DIAGRAM
  DATA_MODEL
  THREAT_MODEL
  TEST_REPORT
  DEPLOY_RECORD
  RUNBOOK
  CHANGE_REQUEST
  POSTMORTEM
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CommandStatus {
  PENDING
  DRY_RUN
  EXECUTING
  SUCCEEDED
  FAILED
  ROLLED_BACK
}

// ── Tenant & Environment ──────────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid())
  name      String
  plan      String   @default("standard") // standard | enterprise
  mode      String   @default("autonomous") // autonomous | semi-autonomous
  createdAt DateTime @default(now()) @map("created_at")

  environments Environment[]
  quotas       TenantQuota?
  projects     Project[]

  @@map("tenants")
}

model Environment {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String   // prod | staging | dev
  type      String   // PRODUCTION | STAGING | DEVELOPMENT
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  projects Project[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("environments")
}

model TenantQuota {
  id             String   @id @default(uuid())
  tenantId       String   @unique @map("tenant_id")
  maxProjects    Int      @default(10) @map("max_projects")
  maxParallel    Int      @default(3) @map("max_parallel")
  maxDeploysDay  Int      @default(20) @map("max_deploys_day")
  tokenBudget    BigInt?  @map("token_budget") // NULL = unlimited
  createdAt      DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_quotas")
}

// ── Project & Pipeline ────────────────────────────────────────────

model Project {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  name          String
  type          ProjectType
  description   String?
  repoUrl       String?        @map("repo_url")
  environmentId String?        @map("environment_id")
  status        PipelineStatus @default(PENDING)
  meta          Json           @default("{}")
  createdBy     String         @map("created_by")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  tenant      Tenant?       @relation(fields: [tenantId], references: [id])
  environment Environment?  @relation(fields: [environmentId], references: [id])
  runs        PipelineRun[]
  artifacts   Artifact[]

  @@index([tenantId])
  @@index([status])
  @@index([type])
  @@map("projects")
}

model PipelineRun {
  id            String         @id @default(uuid())
  projectId     String         @map("project_id")
  tenantId      String         @map("tenant_id")
  template      ProjectType
  status        PipelineStatus @default(PENDING)
  currentStage  String?        @map("current_stage")
  startedAt     DateTime?      @map("started_at")
  completedAt   DateTime?      @map("completed_at")
  triggeredBy   String         @map("triggered_by")
  correlationId String         @default(uuid()) @map("correlation_id")

  project   Project         @relation(fields: [projectId], references: [id])
  stages    PipelineStage[]
  approvals Approval[]
  commands  GatewayCommand[]

  @@index([projectId])
  @@index([tenantId])
  @@index([status])
  @@index([correlationId])
  @@map("pipeline_runs")
}

// ── Stage Machine ─────────────────────────────────────────────────

model PipelineStage {
  id           String      @id @default(uuid())
  runId        String      @map("run_id")
  tenantId     String      @map("tenant_id")
  stageName    String      @map("stage_name")
  stageOrder   Int         @map("stage_order")
  status       StageStatus @default(PENDING)
  ownerAgent   String      @map("owner_agent")
  startedAt    DateTime?   @map("started_at")
  completedAt  DateTime?   @map("completed_at")
  gateResult   Json?       @map("gate_result")
  attempts     Int         @default(0)
  maxAttempts  Int         @default(3) @map("max_attempts")

  run PipelineRun @relation(fields: [runId], references: [id])

  @@unique([runId, stageName])
  @@index([runId])
  @@index([tenantId])
  @@index([status])
  @@map("pipeline_stages")
}

// ── Artifacts ─────────────────────────────────────────────────────

model Artifact {
  id           String       @id @default(uuid())
  tenantId     String       @map("tenant_id")
  projectId    String       @map("project_id")
  runId        String?      @map("run_id")
  stageName    String?      @map("stage_name")
  type         ArtifactType
  title        String
  version      Int          @default(1)
  contentHash  String       @map("content_hash")
  content      Json
  contentPath  String?      @map("content_path")
  ownerAgent   String       @map("owner_agent")
  isSuperseded Boolean      @default(false) @map("is_superseded")
  supersededBy String?      @map("superseded_by")
  createdAt    DateTime     @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id])

  changeRequests ChangeRequest[]

  @@index([tenantId])
  @@index([projectId])
  @@index([type])
  @@index([stageName])
  @@index([contentHash])
  @@map("artifacts")
}

model ChangeRequest {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  projectId   String   @map("project_id")
  artifactId  String   @map("artifact_id")
  requestedBy String   @map("requested_by")
  description String
  impact      String   // LOW | MEDIUM | HIGH
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedBy  String?  @map("approved_by")
  approvedAt  DateTime? @map("approved_at")
  createdAt   DateTime @default(now()) @map("created_at")

  artifact Artifact @relation(fields: [artifactId], references: [id])

  @@index([projectId])
  @@index([status])
  @@map("change_requests")
}

// ── Policy & Approvals ────────────────────────────────────────────

model PolicyRule {
  id             String    @id @default(uuid())
  tenantId       String?   @map("tenant_id") // NULL = системное правило
  name           String
  action         String    // deploy.prod | git.merge_main | db.migrate | ...
  environment    String?   // NULL = все окружения
  conditions     Json      // { require: [...], deny_if: [...] }
  riskLevel      RiskLevel @map("risk_level")
  requireHuman   Boolean   @default(false) @map("require_human")
  requireAgents  String[]  @map("require_agents")
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")

  approvals Approval[]

  @@unique([tenantId, name])
  @@index([action])
  @@index([tenantId])
  @@map("policy_rules")
}

model Approval {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  runId        String    @map("run_id")
  stageName    String    @map("stage_name")
  action       String
  policyRuleId String?   @map("policy_rule_id")
  requestedBy  String    @map("requested_by")
  approvedBy   String?   @map("approved_by")
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED | EXPIRED
  reason       String?
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  decidedAt    DateTime? @map("decided_at")

  run        PipelineRun @relation(fields: [runId], references: [id])
  policyRule PolicyRule? @relation(fields: [policyRuleId], references: [id])

  @@index([runId])
  @@index([tenantId])
  @@index([status])
  @@map("approvals")
}

// ── Tool Gateway ──────────────────────────────────────────────────

model GatewayCommand {
  id               String        @id @default(uuid())
  tenantId         String        @map("tenant_id")
  idempotencyKey   String        @unique @map("idempotency_key")
  action           String        // git.push | deploy.prod | db.migrate | ...
  tool             String        // git | ci | docker | kubectl | psql
  params           Json
  environment      String?
  isDryRun         Boolean       @default(false) @map("is_dry_run")
  dryRunResult     Json?         @map("dry_run_result")
  status           CommandStatus @default(PENDING)
  executedBy       String        @map("executed_by")
  approvalId       String?       @map("approval_id")
  runId            String?       @map("run_id")
  result           Json?
  error            String?
  startedAt        DateTime?     @map("started_at")
  completedAt      DateTime?     @map("completed_at")
  rollbackCommandId String?      @map("rollback_command_id")
  createdAt        DateTime      @default(now()) @map("created_at")

  run PipelineRun? @relation(fields: [runId], references: [id])

  @@index([tenantId])
  @@index([action])
  @@index([status])
  @@index([runId])
  @@map("gateway_commands")
}

// ── Pipeline Templates ────────────────────────────────────────────

model PipelineTemplate {
  id        String      @id @default(uuid())
  tenantId  String?     @map("tenant_id") // NULL = системный шаблон
  type      ProjectType @unique
  name      String
  stages    Json        // массив stage definitions
  gates     Json        // gate conditions
  policies  Json        // policy rules для этого типа
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("pipeline_templates")
}
